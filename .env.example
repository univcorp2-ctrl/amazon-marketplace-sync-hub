# Runtime
APP_MODE=demo
API_LIVE_ENABLED=false
ENABLE_BACKGROUND_SYNC=false
ENABLE_DOCS=false
APP_API_TOKEN=
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=*
ENABLED_CHANNELS=shopee

# Amazon Selling Partner API (Japan)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-fe.amazon.com
AMAZON_MARKETPLACE_ID=A1VC38T7YXB528
AMAZON_CACHE_TTL_SECONDS=300

# Shopee Open Platform
SHOPEE_PARTNER_ID=0
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=0
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
# Private persistent backend volume only; never commit or upload this file.
SHOPEE_TOKEN_STATE_FILE=./secrets/shopee-token-state.json
SHOPEE_BASE_URL=https://partner.shopeemobile.com
SHOPEE_DEFAULT_CATEGORY_ID=0
SHOPEE_LOGISTIC_INFO=[]
SHOPEE_MAX_IMAGE_BYTES=10000000
# Comma-separated seller-controlled CDN/storage hostnames.
IMAGE_HOST_ALLOWLIST=

# Qoo10 QAPI (optional; disabled unless ENABLED_CHANNELS includes qoo10)
QOO10_API_KEY=
QOO10_USER_ID=
QOO10_PASSWORD=
QOO10_BASE_URL=https://api.qoo10.jp
QOO10_DEFAULT_CATEGORY_ID=
QOO10_SHIPPING_NO=0
QOO10_CONTACT_TEL=
QOO10_PRODUCTION_PLACE=Japan

# Pricing / safety stock
PRICE_MARKUP=1.18
PRICE_FIXED_FEE=300
MINIMUM_MARGIN=300
SOURCE_TO_TARGET_FX_RATE=1.0
TARGET_CURRENCY=JPY
MARKETPLACE_FEE_RATE=0.0
SHIPPING_COST=0
PRICE_ROUNDING_STEP=10
STOCK_BUFFER_QUANTITY=1
SYNC_INTERVAL_SECONDS=900
RIGHTS_CONFIRMATION_REQUIRED=true
ALLOW_SOURCE_CONTENT_REUSE=false
DEFAULT_PACKAGE_WEIGHT_KG=0.8
DEFAULT_PACKAGE_LENGTH_CM=30
DEFAULT_PACKAGE_WIDTH_CM=20
DEFAULT_PACKAGE_HEIGHT_CM=10

# Cloudflare Pages build-time optional backend URL
PUBLIC_API_BASE_URL=
